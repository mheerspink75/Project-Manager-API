# ============================================================================
# Project Manager API - environment template
#
# Copy to `.env` and replace the placeholder values. `.env` is gitignored and
# must never be committed. The `SECRET_KEY` value below is a PLACEHOLDER that
# the application REJECTS outside of development - you MUST set a strong,
# random secret (e.g. `openssl rand -hex 32`) before running in production.
# ============================================================================

# development | test | production
ENVIRONMENT=production

# REQUIRED. A strong random secret used to sign JWTs. The placeholder below
# will be rejected by the app unless ENVIRONMENT=development.
#   Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-generate-a-strong-random-secret

# JWT / token lifetimes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database. Use Postgres in the Docker stack (see docker-compose.yml).
# SQLite is for local development and tests ONLY.
#   Postgres example:
#   DATABASE_URL=postgresql+psycopg://pm_user:pm_pass@db:5432/project_manager
#   SQLite (local dev only):
DATABASE_URL=sqlite:///./project_manager.db

# SQLAlchemy engine pooling (applies to non-SQLite backends such as Postgres)
ENGINE_POOL_SIZE=10
ENGINE_MAX_OVERFLOW=20

# Login lockout: max failed attempts per identifier per sliding window.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=300
